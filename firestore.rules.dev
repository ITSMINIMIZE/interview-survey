rules_version = '2';

// ⚠️⚠️ DEV MODE เท่านั้น — ห้ามใช้ตอนเก็บข้อมูลจริง ⚠️⚠️
//
// ใช้ช่วงพัฒนา/ทดลองคนเดียว: เปิดอ่าน-เขียน-ลบทุกอย่างให้บัญชีที่ login แล้ว
// (แอปผู้สำรวจ sign-in anonymous อัตโนมัติ → ผ่านหมด)
//
// 🔒 หมดอายุ 30 ก.ย. 2026 — พ้นวันนั้นทุก request จะถูกปฏิเสธ
//    ตั้งใจให้พังเอง จะได้ไม่ลืมล็อกก่อนเปิดใช้งานจริง
//
// ก่อนเก็บข้อมูลจริง → เอา firestore.rules (ตัวเต็ม) ไป publish แทนไฟล์นี้

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.time < timestamp.date(2026, 9, 30);
    }
  }
}
